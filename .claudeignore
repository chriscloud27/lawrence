# Exclude from Claude's context window

# Large generated files
node_modules/
dist/
build/
.next/
.cache/

# Secrets (should never be in context)
.env.local
.env.production
*.pem
*.key

# n8n runtime data (large, not source code)
docker/volumes/
n8n/.n8n/

# Database dumps
*.sql.gz
*.dump

# Logs
logs/
*.log

# OS artifacts
.DS_Store
Thumbs.db

# Editor artifacts
.vscode/
.idea/
