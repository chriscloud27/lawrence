    {
      "parameters": {
        "jsCode": "// Phase 2b: Re-Score to 0-100 based on AI Agent response\nconst aiReply = $json.reply.toLowerCase();\nconst originalBreakdown = $('pre-qualifyJS').item.json.breakdown;\n\nconst refinedBreakdown = { ...originalBreakdown };\n\n// Boost Budget based on AI signals\nif (/premium|invest|afford|cost-effective|worth/.test(aiReply)) {\n  refinedBreakdown.budget = Math.min(25, originalBreakdown.budget + 8);\n}\n\n// Boost Timeline based on AI signals\nif (/september|exam|deadline|start.*term|next.*year|semester/.test(aiReply)) {\n  refinedBreakdown.timeline = Math.min(25, originalBreakdown.timeline + 10);\n}\n\n// Boost Authority based on AI signals\nif (/i decide|my decision|we.?decided|i.?want/.test(aiReply)) {\n  refinedBreakdown.authority = Math.min(25, originalBreakdown.authority + 8);\n}\n\n// NEW DIMENSION: Need (0-25)\nlet needScore = 0;\nif (/exam|entrance|entrance exam|igcse|a-level|boarding|admissions|test prep/.test(aiReply)) {\n  needScore = 20;\n} else if (/help|support|advice|guidance/.test(aiReply)) {\n  needScore = 12;\n} else {\n  needScore = 5;\n}\n\nconst refinedScore = refinedBreakdown.timeline + refinedBreakdown.budget + refinedBreakdown.authority + needScore;\n\nreturn {\n  score: Math.min(100, refinedScore),\n  breakdown: { ...refinedBreakdown, need: needScore },\n  aiResponse: aiReply,\n  originalScore: $('pre-qualifyJS').item.json.score,\n  reply: $json.reply,\n  sessionId: $('pre-qualifyJS').item.json.sessionId\n};"
      },
