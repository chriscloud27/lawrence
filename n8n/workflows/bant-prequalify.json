      "parameters": {
        "jsCode": "// BANT Pre-Qualification Scoring (Phase 1)\n// Body may optionally include `previousBreakdown: {timeline, budget, authority}`\n// (whatever this node itself returned on the prior turn) so score accumulates\n// across a conversation instead of resetting on every call.\nconst input = $input.item.json.body;\nconst mediumThreshold = $input.item.json.BANT_MEDIUM_THRESHOLD;\nconst hotThreshold = $input.item.json.BANT_HOT_THRESHOLD;\nconst previousBreakdown = input.previousBreakdown || {};\nconst text = (input.chatInput || '').toLowerCase();\n\nconst scores = {\n  timeline: 0,\n  budget: 0,\n  authority: 0\n};\n\n// ===== TIMELINE SCORING (0-25) =====\nif (/urgent|next month|soon|week|semester starts|september|january/.test(text)) {\n  scores.timeline = 23;\n} else if (/few months|spring|next term|end of year|before next year/.test(text)) {\n  scores.timeline = 15;\n} else if (/exploring|sometime|eventually|not sure/.test(text)) {\n  scores.timeline = 8;\n} else if (/just researching|just looking/.test(text)) {\n  scores.timeline = 2;\n} else {\n  scores.timeline = 3;\n}\n\n// ===== BUDGET SCORING (0-25) =====\nif (/premium|international school|boarding|selective|top-tier/.test(text)) {\n  scores.budget = 22;\n} else if (/private/.test(text) && !/(considering|both)/.test(text)) {\n  scores.budget = 22;\n} else if (/considering private|looking at both|open to options/.test(text)) {\n  scores.budget = 14;\n} else if (/public school|state school|cost-conscious|budget matters|budget-conscious/.test(text)) {\n  scores.budget = 8;\n} else if (/very budget-limited|cannot afford|budget-limited/.test(text)) {\n  scores.budget = 2;\n} else {\n  scores.budget = 3;\n}\n\n// ===== AUTHORITY SCORING (0-25) =====\nif (/i decide|i'm looking|i want|my decision|i lead/.test(text)) {\n  scores.authority = 22;\n} else if (/we decide|with.*spouse|partner and i|family consensus|joint decision/.test(text)) {\n  scores.authority = 16;\n} else if (/consulting with|discussing with|getting input from|consulting with family/.test(text)) {\n  scores.authority = 9;\n} else if (/spouse decides|partner is leading|not my decision/.test(text)) {\n  scores.authority = 2;\n} else {\n  scores.authority = 3;\n}\n\n// ===== MERGE WITH PRIOR TURNS (accumulate, never decrease) =====\nconst breakdown = {\n  timeline: Math.max(scores.timeline, previousBreakdown.timeline || 0),\n  budget: Math.max(scores.budget, previousBreakdown.budget || 0),\n  authority: Math.max(scores.authority, previousBreakdown.authority || 0)\n};\n\n// ===== CALCULATE TOTAL SCORE & TIER =====\nconst prequalScore = breakdown.timeline + breakdown.budget + breakdown.authority;\n\nconst tier = prequalScore < mediumThreshold\n  ? 'low'\n  : prequalScore <= hotThreshold\n  ? 'medium'\n  : 'high';\n\nreturn {\n  score: prequalScore,\n  breakdown: breakdown,\n  tier: tier,\n  message: `Pre-qual score: ${prequalScore}/75 (${tier} tier)`,\n  chatInput: input.chatInput,\n  sessionId: input.sessionId\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
