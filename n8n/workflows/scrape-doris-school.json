    {
      "id": "22222222-2222-2222-2222-000000000015",
      "name": "Get School ID",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3320,
        440
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Supabase returns an array for upserts with return=representation. Inject school_id into fee rows.\nconst resp = $input.first().json;\nconst row = Array.isArray(resp) ? resp[0] : resp;\nconst schoolId = row.id;\nconst prev = $('Validate & Assemble').first().json;\nconst fees = prev.fees.map(f => Object.assign({}, f, { school_id: schoolId }));\nreturn [{ json: {\n  school_id: schoolId,\n  fees,\n  fees_count: fees.length,\n  scrape_queue_id: prev.scrape_queue_id,\n  content_hash: prev.content_hash,\n  etag: prev.etag,\n} }];"
      }
    },
