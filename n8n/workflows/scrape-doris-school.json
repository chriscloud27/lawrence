    {
      "id": "22222222-2222-2222-2222-000000000010",
      "name": "Build Extraction Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2220,
        540
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Source of truth for this prompt is src/agents/prompts/school-extraction.txt.\n// Keep in sync when the prompt changes (see the Sticky Note on this canvas).\nconst SYSTEM_PROMPT = \"You are a structured data extraction engine. Your only job is to extract school information from HTML and return a valid JSON object matching the schema exactly. Do not add commentary, explanation, or markdown. Return only the JSON object.\\n\\nSCHEMA:\\n{\\n  \\\"school\\\": {\\n    \\\"slug\\\": \\\"string — url-safe lowercase, hyphens, derived from school name\\\",\\n    \\\"name\\\": \\\"string\\\",\\n    \\\"official_url\\\": \\\"string | null\\\",\\n    \\\"founded_year\\\": \\\"integer | null\\\",\\n    \\\"address_street\\\": \\\"string | null\\\",\\n    \\\"address_city\\\": \\\"string | null\\\",\\n    \\\"address_region\\\": \\\"string | null\\\",\\n    \\\"address_country\\\": \\\"string | null\\\",\\n    \\\"address_postcode\\\": \\\"string | null\\\",\\n    \\\"lat\\\": \\\"float | null\\\",\\n    \\\"lng\\\": \\\"float | null\\\",\\n    \\\"description\\\": \\\"string | null — max 500 chars, factual summary\\\",\\n    \\\"school_type\\\": \\\"one of: Independent | State | Semi-private | International | null\\\",\\n    \\\"governance\\\": \\\"string | null\\\",\\n    \\\"religious_affiliation\\\": \\\"string | null — exact value or 'None'\\\",\\n    \\\"gender_policy\\\": \\\"one of: Co-educational | Boys | Girls | Co-educational (boarding) | null\\\",\\n    \\\"boarding_available\\\": \\\"boolean\\\",\\n    \\\"day_available\\\": \\\"boolean\\\",\\n    \\\"student_count\\\": \\\"integer | null\\\",\\n    \\\"age_min\\\": \\\"integer | null\\\",\\n    \\\"age_max\\\": \\\"integer | null\\\",\\n    \\\"curricula\\\": \\\"array of strings — ONLY use values from the CURRICULA ENUM LIST below\\\",\\n    \\\"languages_instruction\\\": \\\"array of strings — ONLY use values from LANGUAGES ENUM LIST below\\\",\\n    \\\"languages_offered\\\": \\\"array of strings — free text, languages taught as subjects\\\",\\n    \\\"strengths\\\": \\\"array of strings — ONLY use values from STRENGTHS ENUM LIST below\\\",\\n    \\\"sen_learning_support\\\": \\\"one of: Basic | Moderate | Advanced | Specialist | null\\\",\\n    \\\"sen_behaviour_support\\\": \\\"one of: Basic | Moderate | Advanced | Specialist | null\\\",\\n    \\\"instagram_url\\\": \\\"string | null\\\",\\n    \\\"linkedin_url\\\": \\\"string | null\\\",\\n    \\\"facebook_url\\\": \\\"string | null\\\",\\n    \\\"extraction_confidence\\\": \\\"float 0.0–1.0 — your confidence that all extracted fields are correct\\\"\\n  },\\n  \\\"fees\\\": [\\n    {\\n      \\\"year_group\\\": \\\"string | null — e.g. 'Year 9', 'Year 12', 'Sixth Form'\\\",\\n      \\\"fee_type\\\": \\\"one of: yearly_fee | application_fee | enrollment_fee | additional_fee\\\",\\n      \\\"label\\\": \\\"string | null\\\",\\n      \\\"amount\\\": \\\"float\\\",\\n      \\\"currency\\\": \\\"string — ISO 4217 code e.g. GBP, USD\\\",\\n      \\\"notes\\\": \\\"string | null\\\"\\n    }\\n  ],\\n  \\\"entry_points\\\": [\\n    {\\n      \\\"label\\\": \\\"string | null\\\",\\n      \\\"year_group\\\": \\\"string | null\\\",\\n      \\\"places_available\\\": \\\"integer | null\\\",\\n      \\\"open_date\\\": \\\"ISO date string YYYY-MM-DD | null\\\",\\n      \\\"deadline_date\\\": \\\"ISO date string YYYY-MM-DD | null\\\",\\n      \\\"rolling_admissions\\\": \\\"boolean\\\",\\n      \\\"notes\\\": \\\"string | null\\\"\\n    }\\n  ]\\n}\\n\\nCURRICULA ENUM LIST (use only these values):\\nIB, Cambridge, IEYC (International Early Years Curriculum), Montessori Curriculum, Reggio Emilia Approach, IB (PYP), IPC (International Primary Curriculum), Cambridge (Primary), IB (MYP), IMYC (International Middle Years Curriculum), Cambridge (Secondary), Cambridge IGCSE, Pearson Edexcel IGCSE, IB (DP), IBCP (International Baccalaureate Career-related Programme), Advanced Placement (AP), Cambridge International AS Levels, Cambridge A Levels, BTEC Qualification, American Curriculum, Australian Curriculum, British Curriculum, Canadian Curriculum, Dutch Curriculum, French Curriculum, German Curriculum, Indian Curriculum, Japanese Curriculum, Jordanian Curriculum, Korean Curriculum, Malaysian Curriculum, Myanmar Curriculum, Singapore Curriculum, Swiss Curriculum, Taiwan 108 Curriculum, Thai Curriculum, Christian Curriculum, SEN focussed, Bespoke Curriculum, Waldorf Steiner Curriculum\\n\\nLANGUAGES ENUM LIST (use only these for languages_instruction):\\nEnglish, Mandarin, French, German, Japanese, Korean, Spanish, Hebrew, Malay\\n\\nSTRENGTHS ENUM LIST (use only these values):\\nSport, Performing Arts, Visual and Creative Arts, STEM, Academic Enrichment, Outdoor Education, Service and Sustainability, Languages\\n\\nRULES:\\n1. Return ONLY valid JSON. No preamble, no trailing text.\\n2. If a field cannot be determined from the HTML, use null (not empty string).\\n3. For curricula/strengths/languages, only use values from the enum lists. If something doesn't match, omit it.\\n4. For fees: extract every distinct fee line item as a separate object in the fees array.\\n5. For entry_points: extract every distinct admissions cohort or entry window.\\n6. If HTML appears to be JavaScript-rendered with no real content, return: {\\\"error\\\": \\\"js_rendered\\\", \\\"school\\\": null, \\\"fees\\\": [], \\\"entry_points\\\": []}\\n7. Set extraction_confidence honestly: 1.0 if all major fields are clearly present, 0.5 if significant fields are missing or ambiguous.\\n\";\nreturn [{ json: { model: 'gpt-4o-mini', system: SYSTEM_PROMPT, html: $json.html, content_hash: $json.content_hash } }];"
      }
    },
    {
      "id": "22222222-2222-2222-2222-000000000011",
      "name": "OpenAI Extract",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2440,
        540
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "none",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.OPENAI_API_KEY }}"
