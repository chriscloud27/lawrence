            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ JSON.stringify({ model: $json.model, temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: $json.system }, { role: 'user', content: $json.html } ] }) }}",
        "options": {}
      }
    },
    {
      "id": "22222222-2222-2222-2222-000000000012",
      "name": "Validate & Assemble",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2660,
        540
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parse the LLM JSON, gate on confidence, assemble the school + fees payload.\nconst raw = $input.first().json;\nconst content = raw.choices && raw.choices[0] && raw.choices[0].message && raw.choices[0].message.content;\nconst queue = $('Split In Batches').first().json;\nconst contentHash = $('Build Extraction Request').first().json.content_hash;\nconst headers = $('GET Doris Page').first().json.headers || {};\nconst etag = headers.etag || null;\nconst sourceUrl = queue.url;\nconst scrapeQueueId = queue.id;\n\nfunction fail(error) {\n  return [{ json: { scrape_status: 'failed', error, scrape_queue_id: scrapeQueueId, source_url: sourceUrl } }];\n}\n\nlet parsed;\ntry { parsed = JSON.parse(content); } catch (e) { return fail('LLM returned non-JSON: ' + e.message); }\nif (parsed.error === 'js_rendered') return fail('js_rendered — route to headless fallback');\nif (!parsed.school) return fail('No school object in extraction');\n\nconst conf = parsed.school.extraction_confidence;\nconst scrapeStatus = (typeof conf === 'number' && conf < 0.6) ? 'needs_review' : 'ok';\nconst slug = parsed.school.slug || sourceUrl.split('/').filter(Boolean).pop();\n\nconst school = Object.assign({}, parsed.school, {\n  slug,\n  source_url: sourceUrl,\n  content_hash: contentHash,\n  last_scraped_at: new Date().toISOString(),\n  scrape_status: scrapeStatus,\n});\n\nconst fees = Array.isArray(parsed.fees) ? parsed.fees : [];\n\nreturn [{ json: { school, fees, scrape_status: scrapeStatus, scrape_queue_id: scrapeQueueId, source_url: sourceUrl, content_hash: contentHash, etag } }];"
      }
    },
    {
      "id": "22222222-2222-2222-2222-000000000013",
      "name": "IF Extraction OK",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2880,
