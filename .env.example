# Supabase — required for all pipeline workflows
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Chatbot — Azure PostgreSQL Flexible Server
# FQDN from: terraform output server_fqdn
CHATBOT_DB_HOST=psql-lawrence-prototype.postgres.database.azure.com
CHATBOT_DB_NAME=lawrence
CHATBOT_DB_USER=lawrenceadmin
CHATBOT_DB_PASSWORD=<set in GitHub secret TF_VAR_PG_ADMIN_PASSWORD>
CHATBOT_DB_SSL=true

# Chatbot — Anthropic
ANTHROPIC_API_KEY=<your-anthropic-api-key>
