# Single source of truth for local dev secrets.
# Copy to .env.local (git-ignored) at the REPO ROOT and fill in real values.
# The chatbot reads this same file via a symlink:
#   src/Chatbot/.env.local -> ../../.env.local
# so there is only ONE .env.local, at the repo root.

# ── Supabase (pipeline: n8n, migrations, seeds) ──────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>

# ── Database connection — pick ONE DATABASE_URL, comment the other ───────────
#
# LOCAL (supabase start):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# CLOUD — use the *Session pooler* string (IPv4-compatible). The direct
# db.<project-ref>.supabase.co host is IPv6-only and fails to resolve on IPv4
# networks. Dashboard > Connect > Session pooler:
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Chatbot ──────────────────────────────────────────────────────────────────
# The agent runs in TypeScript at /api/chat (ADR-0018, superseding ADR-0006).
# The system prompt and the BANT thresholds are NOT env vars — they live in the
# `agent_config` table so a counsellor can edit them from Admin without a
# deploy. Only the model routing is overridable here (see the AI section below).
#
# Booking link surfaced by the offer_calendar tool. Was a plaintext value in
# n8n's init-secrets SET node.
CALENDLY_URL=<your-calendly-link>
# Absolute base URL. Used to build the deep link in the hot-lead email, where a
# relative path means nothing.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Which agency this deployment writes leads into. One tenant per deployment for
# the prototype; a host-based resolver is v2 (ADR-0018).
AGENCY_SLUG=demo-agency

# ── Pipeline — OpenAI (school extraction agent, gpt-4o-mini) ─────────────────
OPENAI_API_KEY=<your-openai-api-key>

# ── n8n (ingestion only, after ADR-0018) ─────────────────────────────────────
# Webhook for the n8n `link-lead` workflow (ADR-0008). The /api/lead/link route
# proxies to this after Google sign-in to set leads.user_id server-side.
N8N_LINK_LEAD_WEBHOOK_URL=http://localhost:5678/webhook/link-lead

# ── Upstash Redis — rate limiting (build step 11) ─────────────────────────────
# Free tier is sufficient at every volume in .claude/docs/stack-audit.md.
# Console → Redis → your DB → REST API tab.
# Unset: the limiter fails OPEN in development and CLOSED in production.
UPSTASH_REDIS_REST_URL=https://<your-db>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-rest-token>

# ── Chatbot: Google sign-in via Supabase Auth (ADR-0008) ──────────────────────
# Browser-safe — distinct from SUPABASE_SERVICE_KEY above, which must never
# reach the client. The Google OAuth Client ID/Secret are configured directly
# in the Supabase Dashboard (Authentication > Providers > Google), never here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Google Cloud
## Also used for Supabase → Dashboard → Authentication → Providers → Google
GCP_OAUTH_CLIENT_ID=45678-23434563456-.apps.googleusercontent.com
GCP_OAUTH_CLIENT_SECRET=GO...
# ── AI provider seam (build step 12) ──────────────────────────────────────────
# Every model call routes through src/Chatbot/lib/ai/provider.ts. See
# .claude/rules/ai-providers.md. Set a monthly budget alert in the Anthropic
# console at the same time you create the key — there is no spend cap by default.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Ingestion enrichment only (school_enrich). Optional until that job runs in TS.
OPENAI_API_KEY=<your-openai-api-key>

# Per-job model overrides. Unset = the defaults of record in provider.ts.
# Never change one of these without an eval run — npx promptfoo eval.
# AI_MODEL_PARENT_TURN=
# AI_MODEL_BANT_DELTA=
# AI_MODEL_BANT_REFINE=
# AI_MODEL_SCHOOL_ENRICH=

# Open-weight candidate endpoint (Together, Fireworks, …) via the OpenAI-
# compatible provider. Wired but unrouted. AI_COMPAT_REGION is mandatory before
# any job may point here: ADR-0015 treats serving region as a compliance fact.
# AI_COMPAT_BASE_URL=
# AI_COMPAT_API_KEY=
# AI_COMPAT_REGION=

# ── Write path — Supabase service role (build step 14) ───────────────────────
# Bypasses RLS. Read in exactly one place: src/Chatbot/lib/supabase-admin.ts,
# used by the Inngest functions and the anonymous chat route's agent_config
# read. Never expose it to the browser — it is not NEXT_PUBLIC_ for a reason.
# Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>

# ── Inngest — durable side effects (build step 14) ───────────────────────────
# Locally these stay UNSET: `npx inngest-cli dev` discovers the app over HTTP
# and needs no keys. Set them only for a deployed environment.
# INNGEST_EVENT_KEY=<your-inngest-event-key>
# INNGEST_SIGNING_KEY=<your-inngest-signing-key>

# ── Resend — hot-lead escalation (build step 14) ─────────────────────────────
# Replaces the n8n Gmail node, which per ADR-0017 was wired to an unreachable
# branch and never sent anything. Without a verified sending domain, Resend
# delivers only to its own test recipient — a real limitation, not a failure.
RESEND_API_KEY=<your-resend-api-key>
RESEND_FROM=Lawrence <onboarding@resend.dev>
ADMISSIONS_EMAIL=<where-hot-leads-should-land>
