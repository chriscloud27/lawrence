# Single source of truth for local dev secrets.
# Copy to .env.local (git-ignored) at the REPO ROOT and fill in real values.
# The chatbot reads this same file via a symlink:
#   src/Chatbot/.env.local -> ../../.env.local
# so there is only ONE .env.local, at the repo root.

# ── Supabase (pipeline: n8n, migrations, seeds) ──────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_KEY=<your-service-role-key>

# ── Database connection — pick ONE DATABASE_URL, comment the other ───────────
#
# LOCAL (supabase start):
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
#
# CLOUD — use the *Session pooler* string (IPv4-compatible). The direct
# db.<project-ref>.supabase.co host is IPv6-only and fails to resolve on IPv4
# networks. Dashboard > Connect > Session pooler:
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# ── Chatbot ──────────────────────────────────────────────────────────────────
# AI orchestration runs in the n8n `chat-agent` workflow (ADR-0006). The route
# forwards to this webhook; unset it to fall back to offline mock mode.
# Use the *production* webhook URL n8n shows after you activate the workflow.
N8N_CHAT_WEBHOOK_URL=http://localhost:5678/webhook/chat-agent
# Booking link surfaced by the offer_calendar tool.
CALENDLY_URL=<your-calendly-link>
# Optional agent persona (defaults: Sarah / international school placement across Asia).
AGENT_NAME=Sarah
AGENT_SPECIALTY=international school placement across Asia
# ANTHROPIC_API_KEY is no longer used by the chatbot route (the model lives in
# n8n now). Kept only if other code paths still reference Anthropic directly.
NEXT_PUBLIC_URL=http://localhost:3000
ADMIN_PASSWORD=<set-a-local-admin-password>

# ── Pipeline — OpenAI (school extraction agent, gpt-4o-mini) ─────────────────
OPENAI_API_KEY=<your-openai-api-key>

# ── Chatbot (BANT pre-qual prototype, src/Chatbot) ────────────────────────────
# Webhook for the n8n `bant-prequalify` workflow. The /api/prequalify route
# proxies to this so the URL never reaches the browser directly.
N8N_BANT_WEBHOOK_URL=http://localhost:5678/webhook/chatbot
# Webhook for the n8n `link-lead` workflow (ADR-0008). The /api/lead/link route
# proxies to this after Google sign-in to set leads.user_id server-side.
N8N_LINK_LEAD_WEBHOOK_URL=http://localhost:5678/webhook/link-lead

# ── Chatbot: Google sign-in via Supabase Auth (ADR-0008) ──────────────────────
# Browser-safe — distinct from SUPABASE_SERVICE_KEY above, which must never
# reach the client. The Google OAuth Client ID/Secret are configured directly
# in the Supabase Dashboard (Authentication > Providers > Google), never here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Google Cloud
## Also used for Supabase → Dashboard → Authentication → Providers → Google
GCP_OAUTH_CLIENT_ID=45678-23434563456-.apps.googleusercontent.com
GCP_OAUTH_CLIENT_SECRET=GO...